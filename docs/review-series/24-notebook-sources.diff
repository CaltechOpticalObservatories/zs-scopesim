# %% markdown cell 82d16fc94b1f9df4
+## Rates, explicit exposures and extraction
+
+The editable `EXPOSURES` table above specifies DIT and independent integration counts separately for each detector package and arm. CCDs start at 300 s x 1 or 1200 s x 3. NIR settings account for usable well at the adopted operating point. Peak-charge warnings leave these settings unchanged. Forecasts accumulate the stated number of independent integrations; NDIT in the saved stochastic check is one per readout.
+
+The estimator is source-plus-sky minus an independent equal-time sky. Photon variance includes the configured avalanche factor; dark and effective read variance remain independent. On-source time excludes the separate sky exposure and read/reset overheads.
+
+Each detector package is simulated with its physical QE and geometry, and its boxcar widths are selected using its own expected variance. Instrumental throughput excludes atmospheric absorption; extracted source signal includes the common atmosphere and finite slit/boxcar losses.
+
# %% code cell fa4a57baa887e5ae
+def observe_rates(train, target, name, kind):
+    for plane in train.image_planes:
+        plane.data.fill(0)
+    start = perf_counter()
+    with disable_scopesim_progress_bars():
+        train.observe(target, update=False)
+    elapsed = perf_counter() - start
+    timings.append((name, kind, elapsed))
+    print(f'{name}: {kind} {elapsed:.1f} s', flush=True)
+    return detector_rates(train)
+
+def exposure_settings(name, arms, seconds):
+    mode = 'SPEC_ALTDETECT' if name.startswith('ZS alt') else 'SPEC' if name.startswith('ZS') else name
+    dit, count = np.array(EXPOSURES[mode][seconds]).T
+    assert np.all(dit*count == seconds)
+    settings = {'dit': EXPOSURES[mode][seconds][0][0], 'ndit': 1}
+    for arm, (duration, count) in zip(arms, EXPOSURES[mode][seconds], strict=True):
+        settings[f'dit_{arm}'] = duration
+        settings[f'ndit_{arm}'] = 1
+    return settings, dit, np.array(EXPOSURES[mode][seconds])[:, 1]
+
+def extracted_orders(train, name, signal_rates, sky_rates, noises):
+    orders = {}
+    trace_list, = train.optics_manager.get_all(SpectralTraceList)
+    for trace_id, trace in trace_list.spectral_traces.items():
+        index, axis, pixels, centers, edges = trace_pixel_grid(train, trace_id)
+        midpoint = (edges[0] + edges[-1])/2
+        spatial_axis = 'y' if axis == 'x' else 'x'
+        aperture = train.trace_detector_coordinates(xi=np.array([-1.5, 1.5])*SEEING*u.arcsec, wavelengths={trace_id: midpoint.reshape(1)})
+        max_width = int(np.ceil(np.ptp(aperture[f'detector_{spatial_axis}'].to_value(u.pixel))))
+        size = signal_rates[index].shape[0 if axis == 'x' else 1]
+        valid = np.flatnonzero((centers >= max_width/2) & (centers < size-max_width/2))
+        assert len(valid) and np.all(np.diff(valid) == 1), (name, trace_id)
+        first, last = valid[0], valid[-1]
+        pixels, centers, edges = pixels[first:last+1], centers[first:last+1], edges[first:last+2]
+        dit, dark, readvar, nexp = noises[index]
+        factor = train.detector_managers[index][0]._native_header['EXNOISE']
+        widths = choose_boxcar(signal_rates[index]*3600, sky_rates[index]*3600, axis, pixels, centers, max_width, (dark+readvar)*nexp, excess_noise_factor=factor)
+        signal = boxcar_sum(signal_rates[index], axis, pixels, centers, widths)
+        sky = boxcar_sum(sky_rates[index], axis, pixels, centers, widths)
+        orders[trace_id] = {'index': index, 'axis': axis, 'pixels': pixels, 'centers': centers, 'edges': edges, 'widths': widths, 'source_rate': signal, 'sky_rate': sky, 'excess_noise_factor': factor}
+        aperture_rows.append((name, trace_id, widths.min(), widths.max(), signal.sum(), sky.sum()))
+    return orders
+
