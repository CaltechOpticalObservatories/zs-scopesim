+# Independent blank readouts share optical rates but must have independent detector noise.
+noise_rows, source_noise_rows = [], []
+for channel in ['BLUE', 'GREEN', 'RED', 'YJ', 'H', 'K']:
+    with fits.open(output_dir / f'FLAT_AB_sky_0_{channel}.fits.gz') as first, fits.open(output_dir / f'KN_1.5d_sky_0_{channel}.fits.gz') as second:
+        residual = (first[1].data - second[1].data) / np.sqrt(first['VARIANCE'].data + second['VARIANCE'].data)
+        noise_rows.append((channel, residual.size, np.mean(residual, dtype=np.float64), np.std(residual, dtype=np.float64)))
+        blank_variance = first['VARIANCE'].data
+        excess_noise = first[1].header['EXNOISE']
+    with fits.open(output_dir / f'FLAT_AB_SUB_0_{channel}.fits.gz') as combined:
+        # V(A-B) = F*S + 2*V(B), with S the source expectation in input electrons.
+        expected_source = (combined['VARIANCE'].data - 2*blank_variance)/excess_noise
+        illuminated = expected_source > .1*np.max(expected_source)
+        residual = (combined[1].data[illuminated] - expected_source[illuminated]) / np.sqrt(combined['VARIANCE'].data[illuminated])
+        source_noise_rows.append((channel, residual.size, np.mean(residual, dtype=np.float64), np.std(residual, dtype=np.float64)))
+noise_summary = Table(rows=noise_rows, names=['channel', 'pixels', 'standardized_difference_mean', 'standardized_difference_std'])
